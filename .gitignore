# Deploy-time local config (agent id, region) — generated by RCS agent setup
.deploy/

# Node / CDK
node_modules/
cdk/cdk.out/
cdk/cdk.context.json
cdk-outputs.json
cdk/**/*.js
cdk/**/*.d.ts
*.tsbuildinfo

# Web build
web/dist/
web/.env
web/.env.local
web/.env.*

# Environment files in any directory — they can hold the dashboard API key or
# account-specific values. Keep a committed template as .env.example.
.env
.env.*
!.env.example

# Per-user assistant and editor state (MCP config files here can hold access tokens)
.kiro/settings/
.kiro/specs/
.cursor/
.windsurf/
.vscode/
.idea/

# Private keys and test coverage output
*.pem
coverage/

# Python
__pycache__/
*.pyc
lambda/**/build/
.venv/

# Generated at CDK synth time from content/*.md (see cdk/lib/config.ts
# stageContentForLambda) — not a source of truth, don't commit.
lambda/_content/

# Lambda build artifacts
build/
*.zip

# OS / editor
.DS_Store
*.log

# draw.io autosave/backup artifacts
*.drawio.bkp
.$*.drawio.bkp
