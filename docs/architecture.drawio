  <diagram name="Rich media — two paths" id="page-3">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3title" value="Rich media — two image ingress paths" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3laneA" value="" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F8;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1620" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p3laneAlbl" value="A — Native RCS photo &lt;i&gt;(Classify a Photo)&lt;/i&gt;&amp;nbsp; · &amp;nbsp;file bytes traverse the carrier / RBM network → scoped to generic, non-sensitive content" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#DD344C;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="80" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3aPhone" value="Member sends a photo&lt;br&gt;in the RCS thread" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mobile_client;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aEum" value="RCS agent&lt;br&gt;two-way + inbound media" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.end_user_messaging;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aS3" value="S3 &lt;b&gt;inbound/rcs/&lt;/b&gt;&lt;br&gt;written by EUM&#39;s role" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aSns" value="SNS → Channel Adapter&lt;br&gt;writes the source-key reference" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="470" y="270" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aConv" value="Media Convert Lambda&lt;br&gt;joins S3 event ↔ SNS reference&lt;br&gt;&lt;i&gt;raises to retry if not joined yet&lt;/i&gt;" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aWork" value="HEIC/HEIF → RGB JPEG (Pillow + pillow-heif)&lt;br&gt;exif_transpose; if EXIF orientation is 1/absent,&lt;br&gt;ask the vision model for a corrective rotation&lt;br&gt;→ &lt;b&gt;converted-inbound/{sha256}.jpg&lt;/b&gt;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3aBedrock" value="Bedrock classify&lt;br&gt;one non-diagnostic sentence, no PII" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="920" y="280" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aDdb" value="DynamoDB&lt;br&gt;update the original MSG# item&lt;br&gt;+ CONV# LATEST_MEDIA" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1240" y="270" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3aCb" value="Invoke (Event) Channel Adapter&lt;br&gt;&lt;b&gt;native_media_ready&lt;/b&gt; → sends the&lt;br&gt;“Photo Received” card back over RCS&lt;br&gt;&lt;i&gt;(bot mode only; LIVE mode gets “✅ Picture received.”)&lt;/i&gt;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3laneB" value="" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#7AA116;dashed=1;verticalAlign=top;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1620" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p3laneBlbl" value="B — Secure webview upload &lt;i&gt;(Secure Document Upload)&lt;/i&gt;&amp;nbsp; · &amp;nbsp;file bytes go browser → S3 directly and never through a Lambda → the pattern for PHI-shaped content" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1F7A2E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="450" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3bPhone" value="Member taps the&lt;br&gt;OPEN_URL / WEBVIEW (TALL) chip" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mobile_client;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bApi" value="HTTP API (API Gateway)" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="290" y="520" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bDash" value="Dashboard Lambda&lt;br&gt;serves the webview HTML&lt;br&gt;(brand tokens substituted)" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="500" y="520" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bPresign" value="POST /api/uploads/presign&lt;br&gt;→ presigned &lt;b&gt;PUT&lt;/b&gt; URL, 600 s&lt;br&gt;heic · heif · jpeg · jpg · png only&lt;br&gt;UPLOAD#{hash}/{upload_id} = PENDING" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3bS3" value="S3 &lt;b&gt;raw-uploads/{hash}/{id}&lt;/b&gt;&lt;br&gt;browser PUTs the bytes straight here" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bConv" value="Media Convert Lambda&lt;br&gt;S3 ObjectCreated notification" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1200" y="520" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bWork" value="PROCESSING → convert → classify&lt;br&gt;&lt;b&gt;converted-uploads/{hash}/{id}.jpg&lt;/b&gt;&lt;br&gt;UPLOAD# = READY (or FAILED + error)" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="510" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3bPoll" value="Webview polls&lt;br&gt;GET /api/uploads/{hash}/{id}/status&lt;br&gt;→ READY: “Received” + preview&lt;br&gt;&lt;i&gt;both upload routes are unauthenticated by design —&lt;br&gt;the webview session cannot hold the operator API key&lt;/i&gt;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF6;strokeColor=#7AA116;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="660" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3bDdb" value="DynamoDB UPLOAD# record&lt;br&gt;(TTL-expiring)" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1230" y="690" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3bBedrock" value="Bedrock classify" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1465" y="690" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3note" value="Both paths converge in the dashboard: the Interactive Demos tab polls &lt;b&gt;GET /api/media/latest&lt;/b&gt; every 5 s and renders the newest photo per vignette with its classification, using a presigned &lt;b&gt;GET&lt;/b&gt; URL." style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1620" height="50" as="geometry" />
        </mxCell>
