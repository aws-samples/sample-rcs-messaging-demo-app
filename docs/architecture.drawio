        <mxCell id="p2ev" value="common.log_event()&lt;br&gt;any status event — queued / sent / delivered / read / failed,&lt;br&gt;TTL expired, fell back to SMS, protect-blocked&lt;br&gt;→ MSG# item, direction=&quot;event&quot;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF0FC;strokeColor=#C925D1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2ddb" value="DynamoDB&lt;br&gt;single table" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="761" y="306" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p2log" value="Log the inbound turn once&lt;br&gt;CONV#{phone_hash} · MSG#{ts}&lt;br&gt;&lt;i&gt;media logged via log_inbound_media()&lt;/i&gt;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF0FC;strokeColor=#C925D1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2d2" value="conversation&lt;br&gt;in LIVE mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#4D72B8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2live" value="Bot stays silent — the human care advocate&lt;br&gt;replies from the dashboard console.&lt;br&gt;&lt;br&gt;Exceptions:&lt;br&gt;• &lt;b&gt;handover_end&lt;/b&gt; or &lt;b&gt;home_menu&lt;/b&gt; returns control to the bot&lt;br&gt;• &lt;b&gt;photo_secure_upload&lt;/b&gt; starts the secure-upload flow&lt;br&gt;• a received photo gets “✅ Picture received.”&lt;br&gt;• any other postback gets a nudge card" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#DD344C;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2parse" value="parse_inbound(messageBody) → turn type" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2t1" value="&lt;b&gt;trigger&lt;/b&gt;&lt;br&gt;&quot;Start: Rx_Refill&quot;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2t1b" value="set_active_flow(vignette)&lt;br&gt;FLOW_MAP → flow.on_trigger()&lt;br&gt;&lt;i&gt;unknown key → Welcome carousel&lt;br&gt;benefits_qa / find_care → Bedrock&lt;/i&gt;" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2t2" value="&lt;b&gt;postback&lt;/b&gt;&lt;br&gt;{&quot;type&quot;:&quot;SUGGESTION&quot;, postbackData}" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="800" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2t2b" value="1. handover_start / handover_end (any state)&lt;br&gt;2. home_menu → Welcome carousel&lt;br&gt;3. home_* tile → that flow&#39;s on_start()&lt;br&gt;4. sched_pto / sched_swap cross-flow jumps&lt;br&gt;5. active flow.on_postback(pd)&lt;br&gt;6. prefix fallback across all flows&lt;br&gt;7. last resort: Bedrock assistant" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="880" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2t3" value="&lt;b&gt;media&lt;/b&gt;&lt;br&gt;body carries mediaStatus&lt;br&gt;(detected by that field)" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="790" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2t3b" value="convertible image (JPEG/PNG/GIF/HEIC)&lt;br&gt;→ processing ack now; S3-triggered&lt;br&gt;media_convert does the JPEG + Bedrock&lt;br&gt;classify, then calls back&lt;br&gt;&lt;br&gt;handle_media() — everything else:&lt;br&gt;UPLOAD_FAILED → format hint + Secure Upload&lt;br&gt;non-image (PDF/audio/video) → received card" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="880" width="240" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p2t4" value="&lt;b&gt;free text&lt;/b&gt;&lt;br&gt;anything else (also LOCATION)" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="800" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2t4b" value="1. active flow = verification → otp.verify(code)&lt;br&gt;2. active flow = benefits_qa / find_care → Bedrock&lt;br&gt;3. active flow = store → re-show catalog&lt;br&gt;4. keyword router: “human/agent” → LIVE mode;&lt;br&gt;    refill · appointment · store · verify · find&lt;br&gt;5. default → Benefits Q&amp;amp;A assistant" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="880" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2bedrock" value="Amazon Bedrock&lt;br&gt;Converse — grounded on content/*.md" style=" sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1180" y="906" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p2send" value="_send() → common.send_rcs() → &lt;b&gt;SendRcsMessage&lt;/b&gt; (optional TimeToLive)&lt;br&gt;+ log_message() so the dashboard transcript stays in sync" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="1090" width="520" height="60" as="geometry" />
        </mxCell>
